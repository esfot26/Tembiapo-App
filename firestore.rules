rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔐 Función helper para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 🔐 Función helper para verificar que el usuario es el dueño
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // 📁 Reglas para usuarios
    match /usuarios/{userId} {
      // Solo el usuario puede leer y escribir su propio documento
      allow read, write: if isOwner(userId);
    }
    
    // 📁 Reglas para carpetas
    match /carpeta/{userId}/carpetas/{carpetaId} {
      // Solo el creador puede leer, crear, actualizar y eliminar sus carpetas
      allow read, write: if isOwner(userId);
    }
    
    // 📄 Reglas para archivos
    match /carpeta/{userId}/archivos/{archivoId} {
      // Solo el creador puede leer, crear, actualizar y eliminar sus archivos
      allow read, write: if isOwner(userId);
    }
    
    // 📝 Reglas para notas
    match /notas/{userId}/notas/{notaId} {
      // Solo el creador puede leer, crear, actualizar y eliminar sus notas
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
                       request.resource.data.creadorId == userId;
      allow update: if isOwner(userId) && 
                       resource.data.creadorId == userId;
      allow delete: if isOwner(userId) && 
                       resource.data.creadorId == userId;
    }
    
    // 🚫 Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
